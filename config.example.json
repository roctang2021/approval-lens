{
  "lang": "en",
  "min_severity_to_annotate": "info",
  "max_message_chars": 500,
  "llm": {
    "enabled": false,
    "model": "claude-haiku-4-5",
    "timeout_seconds": 3.0,
    "api_key_env": "ANTHROPIC_API_KEY",
    "auth_token_env": "ANTHROPIC_AUTH_TOKEN",
    "cache_ttl_days": 7,
    "send_file_content": false
  },
  "notify": {
    "enabled": false,
    "min_severity": "high"
  }
}
