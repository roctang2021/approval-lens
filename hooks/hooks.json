{
  "description": "Understand what Claude Code is about to do before you approve it, with plain-language explanations of the action and its effects.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|WebFetch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v uv >/dev/null 2>&1 || PATH=\"$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; uv run --quiet \"${CLAUDE_PLUGIN_ROOT}\"/hooks/approval_lens.py' || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
