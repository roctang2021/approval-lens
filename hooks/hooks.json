{
  "description": "Permission Lens — annotates Bash/WebFetch/Write/Edit permission dialogs with a plain-language risk explanation. Never returns a decision; the native dialog always shows.",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash|WebFetch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v uv >/dev/null 2>&1 || PATH=\"$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; uv run --quiet \"${CLAUDE_PLUGIN_ROOT}\"/hooks/permission_lens.py' || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
